# ---------------------------------------------------------------------------
# DevInsight environment template. Copy to .env and fill in.
#   cp .env.example .env
# Never commit the real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=dev-only-insecure-key-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Database --------------------------------------------------------------
# Docker Compose provides these defaults; override DATABASE_URL for a managed host.
POSTGRES_USER=devinsight
POSTGRES_PASSWORD=devinsight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devinsight
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_ECHO=false

# --- GitHub ----------------------------------------------------------------
# Optional. Without a token the API works at 60 requests/hour; with one, 5000/hour.
# Create a fine-grained token at https://github.com/settings/tokens
# It is read only by the backend — never exposed to the frontend.
GITHUB_TOKEN=
GITHUB_PER_PAGE=100
GITHUB_MAX_RETRIES=4
GITHUB_CACHE_TTL=900

# --- Machine learning ------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_ENABLED=false
INGEST_MAX_COMMITS=4000
INGEST_MAX_ISSUES=1500
